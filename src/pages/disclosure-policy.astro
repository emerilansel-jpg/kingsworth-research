---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Disclosure Policy · Kingsworth Research">
<style>
  .page-header { padding: 3rem 0; border-bottom:1px solid var(--color-border); margin-bottom:2rem; }
  .content-section { padding: 1.5rem 0; }
  .content-section p { max-width:700px; line-height:1.8; }
</style>

<div class="container">
  <div class="page-header">
    <h1>Disclosure Policy</h1>
    <p style="color:var(--color-muted);margin-top:0.5rem;">Complete transparency about our financial relationships and limitations.</p>
  </div>
  <div class="content-section">
    <p>Every report published by Kingsworth Research includes a disclosure statement covering:</p>
    <ul style="padding-left:1.5rem; margin:1rem 0;">
      <li style="margin-bottom:0.5rem;">Any commercial relationship with organisations featured or referenced</li>
      <li style="margin-bottom:0.5rem;">Funding sources for the specific research project</li>
      <li style="margin-bottom:0.5rem;">Author and reviewer conflicts of interest</li>
    </ul>
    <p>If undisclosed relationships are identified after publication, we issue a correction notice within 48 hours and update all affected reports.</p>
  </div>
</div>
</BaseLayout>
