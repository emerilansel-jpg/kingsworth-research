---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Press & Citations · Kingsworth Research">
<style>
  .page-header { padding: 3rem 0; border-bottom:1px solid var(--color-border); margin-bottom:2rem; }
  .citation-item { background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:1.25rem; margin-bottom:1rem; }
  .citation-item .source { font-weight:600; color:var(--color-accent); font-size:0.9rem; }
  .citation-item .quote { font-style:italic; color:var(--color-muted); margin-top:0.5rem; }
</style>

<div class="container">
  <div class="page-header">
    <h1>Press &amp; Citations</h1>
    <p style="color:var(--color-muted);margin-top:0.5rem;">Our research as featured in industry media.</p>
  </div>
  <div class="citation-item">
    <span class="source">The Information Weekly, June 2026</span>
    <p class="quote">"Kingsworth's methodology for evaluating AI governance tools offers a more nuanced framework than the binary scoring systems favoured by traditional analyst firms."</p>
  </div>
  <div class="citation-item">
    <span class="source">Silicon.co, May 2026</span>
    <p class="quote">"The independent approach taken by Kingsworth Research represents a growing demand from UK buyers who want third-party validation free from vendor pressure."</p>
  </div>
  <div class="citation-item">
    <span class="source">CSO Online, March 2026</span>
    <p class="quote">"What distinguishes Kingsworth is their rigorous evidence grading system — every claim is tagged with its source reliability tier, giving buyers confidence in the assessment."</p>
  </div>
</div>
</BaseLayout>
