---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Category Definitions · Kingsworth Research">
<style>
  .page-header { padding: 3rem 0; border-bottom:1px solid var(--color-border); margin-bottom:2rem; }
  .cat-list { list-style:none; margin-top:1.5rem; }
  .cat-item { background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:1.25rem; margin-bottom:0.75rem; }
  .cat-item h4 { font-family:var(--font-heading); color:var(--color-primary); margin-bottom:0.25rem; }
  .cat-item p { font-size:0.95rem; color:var(--color-muted); margin:0; line-height:1.6; }
</style>

<div class="container">
  <div class="page-header">
    <h1>Category Definitions</h1>
    <p style="color:var(--color-muted);margin-top:0.5rem;">Standardised market definitions used across our research programme.</p>
  </div>
  <ul class="cat-list">
    <li class="cat-item"><h4>Enterprise AI Governance Platforms</h4><p>Solutions providing model lifecycle management, regulatory compliance tracking, bias detection, explainability tooling, and audit trails for ML systems deployed at enterprise scale.</p></li>
    <li class="cat-item"><h4>Data Loss Prevention</h4><p>Systems that prevent unauthorised data exfiltration through content inspection, contextual policy enforcement, user behaviour analytics, and cross-channel monitoring (endpoint, network, cloud).</p></li>
    <li class="cat-item"><h4>Identity Verification Infrastructure</h4><p>Integrated platforms enabling digital identity proofing through document authentication, biometric verification, liveness detection, and continuous identity monitoring for KYC/AML compliance.</p></li>
  </ul>
</div>
</BaseLayout>
