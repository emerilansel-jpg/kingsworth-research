---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Team · Kingsworth Research">
<style>
  .page-header { padding: 3rem 0; border-bottom:1px solid var(--color-border); margin-bottom:2rem; }
  .team-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(280px,1fr)); gap:1.5rem; }
  .team-card { background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:1.5rem; text-align:center; }
  .team-card h4 { font-family:var(--font-heading); color:var(--color-primary); font-size:1.15rem; }
  .team-card p { color:var(--color-muted); font-size:0.9rem; margin-top:0.25rem; line-height:1.6; }
  .team-card .role { font-weight:600; color:var(--color-accent); font-size:0.85rem; text-transform:uppercase; letter-spacing:0.05em; }
</style>

<div class="container">
  <div class="page-header">
    <h1>Our Team</h1>
    <p style="color:var(--color-muted);margin-top:0.5rem;">Experienced analysts and researchers based in Manchester.</p>
  </div>
  <div class="team-grid">
    <div class="team-card">
      <div class="role">Managing Director &amp; Chief Analyst</div>
      <h4>Alistair Whitmore-Frost</h4>
      <p>Former technology analyst at Forrester with 22 years experience covering enterprise software markets. Specialises in vendor evaluation frameworks and market mapping.</p>
    </div>
    <div class="team-card">
      <div class="role">Lead Researcher</div>
      <h4>Dr. Priya Shah</h4>
      <p>PhD in Computational Economics, LSE. Former data scientist at Deloitte. Leads quantitative analysis and benchmarking methodology across all report types.</p>
    </div>
    <div class="team-card">
      <div class="role">Compliance &amp; Standards Lead</div>
      <h4>Thomas MacAllister</h4>
      <p>15 years in financial services compliance (FCA, PRA). Ensures all research outputs meet highest standards of rigour and regulatory awareness.</p>
    </div>
  </div>
</div>
</BaseLayout>
