---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact · Kingsworth Research">
<style>
  .page-header { padding: 3rem 0; border-bottom:1px solid var(--color-border); margin-bottom:2rem; }
  .contact-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(260px,1fr)); gap:1.5rem; margin-top:1.5rem; }
  .contact-card { background:var(--color-surface); border:1px solid var(--color-border); border-radius:var(--radius); padding:1.5rem; }
  .contact-card h4 { font-family:var(--font-heading); color:var(--color-primary); margin-bottom:0.75rem; }
  .contact-card p, .contact-card a { color:var(--color-muted); font-size:0.95rem; line-height:1.7; }
</style>

<div class="container">
  <div class="page-header">
    <h1>Contact</h1>
    <p style="color:var(--color-muted);margin-top:0.5rem;">Reach our team directly.</p>
  </div>

  <div class="contact-grid">
    <div class="contact-card">
      <h4>General Inquiries</h4>
      <p><a href="mailto:inquiries@kingsworthresearch.com">inquiries@kingsworthresearch.com</a></p>
    </div>
    <div class="contact-card">
      <h4>Editorial Team</h4>
      <p><a href="mailto:editorial@kingsworthresearch.com">editorial@kingsworthresearch.com</a></p>
    </div>
    <div class="contact-card">
      <h4>Corrections</h4>
      <p><a href="mailto:corrections@kingsworthresearch.com">corrections@kingsworthresearch.com</a></p>
    </div>
    <div class="contact-card">
      <h4>Phone</h4>
      <p>+44 161 555 0372</p>
    </div>
    <div class="contact-card">
      <h4>Address</h4>
      <p>10 King Street, Suite 200<br/>Manchester, M2 6AW<br/>United Kingdom</p>
    </div>
    <div class="contact-card">
      <h4>Press &amp; Media</h4>
      <p><a href="mailto:press@kingsworthresearch.com">press@kingsworthresearch.com</a></p>
    </div>
  </div>
</div>
</BaseLayout>
