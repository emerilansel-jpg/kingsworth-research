---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Editorial Policy · Kingsworth Research">
<style>
  .page-header { padding: 3rem 0; border-bottom:1px solid var(--color-border); margin-bottom:2rem; }
  .content-section { padding: 1.5rem 0; }
  .content-section p { max-width:700px; line-height:1.8; }
</style>

<div class="container">
  <div class="page-header">
    <h1>Editorial Policy</h1>
    <p style="color:var(--color-muted);margin-top:0.5rem;">Our commitment to independence and accuracy.</p>
  </div>
  <div class="content-section">
    <p>All editorial decisions are made independently by our research team. We do not accept payment, sponsorship, or other compensation that could influence our evaluations, rankings, or content coverage. Organisations referenced in reports may comment on draft versions but have no power to alter conclusions.</p>
    <p style="margin-top:1rem;">All analysts sign annual conflict-of-interest declarations. Any conflicts relevant to specific reports are disclosed alongside those publications.</p>
  </div>
</div>
</BaseLayout>
